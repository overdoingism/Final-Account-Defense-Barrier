' UIArt : DPI-aware image supplier.
'
' Every picture the UI uses is requested here by name (UIArt.button_confirm, UIArt.Form_Main ...)
' and is produced at the current DPI scale from up to two sources:
'
'   1. A "painter" (UIArtPainters.vb) - geometry drawn by code, so it stays sharp at any DPI.
'   2. A "layer" PNG (AllResource\Layers) - whatever the painter does not draw (mostly the text).
'      It is the difference between the original artwork and the painter output at 100%,
'      generated by the art tool (arttool, kept outside this repository). It is enlarged with bicubic filtering at high DPI.
'
' An image without a painter simply has the whole original picture as its layer.

Imports System.Drawing
Imports System.Drawing.Drawing2D
Imports System.Drawing.Imaging
Imports System.Runtime.InteropServices

Partial Public NotInheritable Class UIArt

    Private Sub New()
    End Sub

    Public Const NoDpi_str As String = "NODPI"

    Private Shared _scale As Single = 0.0F
    Private Shared _dpiAware As Boolean = False
    Private Shared ReadOnly _initLock As New Object
    Private Shared ReadOnly Painters As New Dictionary(Of String, Action(Of ArtCanvas))(StringComparer.Ordinal)

    ' Finishing steps that work on the pixels of a picture once painter, layers and lettering are in place
    ' (picture, scale). They are left out when a picture is rendered without its lettering.
    Private Shared ReadOnly AfterPainters As New Dictionary(Of String, Action(Of Bitmap, Single))(StringComparer.Ordinal)

    ''' <summary>Supplies the 100% layer bitmap of an image (Nothing if the image has no layer).</summary>
    Public Shared LayerProvider As Func(Of String, Bitmap) = AddressOf EmbeddedLayer

    <DllImport("user32.dll")>
    Private Shared Function SetProcessDPIAware() As Boolean
    End Function

    Shared Sub New()
        RegisterPainters()
    End Sub

    ''' <summary>
    ''' Must run before the first window is created. Declares the process DPI aware
    ''' (unless the NODPI argument is given) and reads the scale factor.
    ''' </summary>
    Public Shared Sub Init()

        SyncLock _initLock

            If _scale > 0.0F Then Exit Sub

            Dim WantAware As Boolean = True

            Try
                For Each ArgStr As String In Environment.GetCommandLineArgs()
                    If ArgStr.ToUpper = NoDpi_str Then WantAware = False
                Next
            Catch ex As Exception
            End Try

            If WantAware Then
                Try
                    SetProcessDPIAware()
                    _dpiAware = True
                Catch ex As Exception
                    _dpiAware = False
                End Try
            End If

            Dim TmpScale As Single = 1.0F

            Try
                Using g As Graphics = Graphics.FromHwnd(IntPtr.Zero)
                    TmpScale = g.DpiX / 96.0F
                End Using
            Catch ex As Exception
                TmpScale = 1.0F
            End Try

            If TmpScale < 0.5F OrElse TmpScale > 8.0F Then TmpScale = 1.0F
            _scale = TmpScale

        End SyncLock

    End Sub

    ''' <summary>Test / tool use only: force a scale factor.</summary>
    Public Shared Sub ForceScale(NewScale As Single)
        SyncLock _initLock
            _scale = NewScale
        End SyncLock
    End Sub

    ''' <summary>UI scale factor: 1.0 = 96 DPI, 1.75 = 168 DPI ...</summary>
    Public Shared ReadOnly Property Scale As Single
        Get
            If _scale <= 0.0F Then Init()
            Return _scale
        End Get
    End Property

    Public Shared ReadOnly Property DpiAware As Boolean
        Get
            If _scale <= 0.0F Then Init()
            Return _dpiAware
        End Get
    End Property

    ''' <summary>Converts a 96-DPI design length to device pixels.</summary>
    Public Shared Function S(DesignPixels As Double) As Integer
        Return CInt(Math.Round(DesignPixels * Scale))
    End Function

    ''' <summary>Size of a picture at 100% (Size.Empty if unknown).</summary>
    Public Shared Function BaseSizeOf(Name As String) As Size
        Dim Sz As Size
        If BaseSizes.TryGetValue(Name, Sz) Then Return Sz
        Return Size.Empty
    End Function

    Public Shared Function HasPainter(Name As String) As Boolean
        Return Painters.ContainsKey(Name) OrElse Derived.ContainsKey(Name)
    End Function

    ' Small pictures are rendered once and handed out as copies: the forms ask for the same
    ' buttons many times. Window backgrounds are too big to keep around.
    Private Const CacheMaxPixels As Long = 150000
    Private Shared ReadOnly _cache As New Dictionary(Of String, Bitmap)(StringComparer.Ordinal)
    Private Shared ReadOnly _nameLocks As New Dictionary(Of String, Object)(StringComparer.Ordinal)

    Private Shared Function IsCacheable(Name As String) As Boolean
        Dim Sz As Size
        If Not BaseSizes.TryGetValue(Name, Sz) Then Return False
        If WindowShapes.Contains(Name) OrElse LimeKeyed.Contains(Name) Then Return False
        Return CLng(Sz.Width * Scale) * CLng(Sz.Height * Scale) <= CacheMaxPixels
    End Function

    Private Shared Function InDesigner() As Boolean
        Return System.ComponentModel.LicenseManager.UsageMode = System.ComponentModel.LicenseUsageMode.Designtime
    End Function

    ''' <summary>The image at the current UI scale. Always a new bitmap the caller owns.</summary>
    Public Shared Function Img(Name As String) As Bitmap

        ' The forms' designer code assigns the window backgrounds, but at run time every form replaces
        ' them with the glow-filtered version (VisualModule.Load_Bitmap_For_Threads) before it is shown.
        ' Rendering them here as well would only cost start-up time, so outside the designer a stub is returned.
        If WindowShapes.Contains(Name) AndAlso Not InDesigner() Then Return New Bitmap(1, 1, PixelFormat.Format32bppArgb)

        If Not IsCacheable(Name) Then Return Produce(Name)

        Dim Lk As Object = Nothing
        SyncLock _nameLocks
            If Not _nameLocks.TryGetValue(Name, Lk) Then
                Lk = New Object
                _nameLocks(Name) = Lk
            End If
        End SyncLock

        SyncLock Lk     'one thread renders a given picture, others wait for it; also guards the shared master bitmap
            Dim Master As Bitmap = Nothing
            SyncLock _cache
                _cache.TryGetValue(Name, Master)
            End SyncLock
            If Master Is Nothing Then
                Master = Produce(Name)
                SyncLock _cache
                    _cache(Name) = Master
                End SyncLock
            End If
            Return Master.Clone(New Rectangle(0, 0, Master.Width, Master.Height), PixelFormat.Format32bppArgb)
        End SyncLock

    End Function

    ' Pictures that get the glow filter right away, like the window backgrounds do: the lit indicators,
    ' the selector captions (KDF type, password generator, language), the CSV window with the
    ' "IMPORTING" / "EXPORTING" picture inside it (their artwork had a glow painted in), and the "PASS"
    ' plate of the key derivation window (the window itself is filtered; without this it looked flat on
    ' it). That window's KDF type caption gets its glow another way, see SpriteOnWindow.
    ' The count-down digits are outlines on black; their artwork had a glow painted in as well.
    Private Shared ReadOnly SelfGlowing As New HashSet(Of String)(StringComparer.Ordinal) From {
        "caps_lock_off", "caps_lock_on", "PASSWORD_HIDE", "PASSWORD_SHOW",
        "KDFS_Types", "PWD_Gen", "Lang_en", "Lang_jp", "Lang_zhtw", "Lang_zhcn", "Lang_load", "Lang_arr", "Lang_arr_on",
        "CSV_Waiting", "CSV_IMP", "CSV_EXP", "PWD_KDF_PASS",
        "DIGI_Y_0", "DIGI_Y_1", "DIGI_Y_2", "DIGI_Y_3", "DIGI_Y_4", "DIGI_Y_5", "DIGI_Y_6", "DIGI_Y_7", "DIGI_Y_8",
        "DIGI_Y_9", "DIGI_Y__"}

    ' ... at this fraction of the filter's full strength (the full glow is too much on these small pictures)
    Private Const SelfGlowStrength As Single = 2.0F / 3.0F

    ' Pictures that are shown side by side as one block: name -> the picture on its left, on its right ("" = none).
    ' The glow filter is run on the whole block, so that its light does not stop where the pictures meet.
    ' The neighbour is drawn by its painter only - its lettering is too far away to matter.
    Private Shared ReadOnly GlowBeside As New Dictionary(Of String, String())(StringComparer.Ordinal) From {
        {"Lang_en", {"", "Lang_arr"}}, {"Lang_jp", {"", "Lang_arr"}},
        {"Lang_zhtw", {"", "Lang_arr"}}, {"Lang_zhcn", {"", "Lang_arr"}},
        {"Lang_arr", {"Lang_en", ""}}, {"Lang_arr_on", {"Lang_en", ""}}}

    Private Shared Function Produce(Name As String) As Bitmap

        Dim Bmp As Bitmap = Render(Name, Scale, True, True)
        If Not SelfGlowing.Contains(Name) Then Return Bmp

        ' What the filter gets to see: the picture itself, or the block it is a part of, or (window shape
        ' on the key colour) the picture without the key colour, which would otherwise shine green onto it.
        Dim Seen As Bitmap = Bmp
        Dim OffX As Integer = 0
        Dim Beside As String() = Nothing

        If GlowBeside.TryGetValue(Name, Beside) Then
            Dim Parts As Bitmap() = {Nothing, Bmp, Nothing}
            If Beside(0) <> "" Then Parts(0) = Render(Beside(0), Scale, True, False, False)
            If Beside(1) <> "" Then Parts(2) = Render(Beside(1), Scale, True, False, False)
            Dim Total As Integer = 0
            For Each Part As Bitmap In Parts
                If Part IsNot Nothing Then Total += Part.Width
            Next
            Seen = New Bitmap(Total, Bmp.Height, PixelFormat.Format32bppArgb)
            Using g As Graphics = Graphics.FromImage(Seen)
                g.CompositingMode = CompositingMode.SourceCopy
                g.InterpolationMode = InterpolationMode.NearestNeighbor
                g.PixelOffsetMode = PixelOffsetMode.Half
                Dim X As Integer = 0
                For Each Part As Bitmap In Parts
                    If Part Is Nothing Then Continue For
                    If Part Is Bmp Then OffX = X
                    g.DrawImage(Part, New Rectangle(X, 0, Part.Width, Part.Height), 0, 0, Part.Width, Part.Height, GraphicsUnit.Pixel)
                    X += Part.Width
                Next
            End Using
            If Parts(0) IsNot Nothing Then Parts(0).Dispose()
            If Parts(2) IsNot Nothing Then Parts(2).Dispose()
        ElseIf LimeKeyed.Contains(Name) Then
            Seen = Bmp.Clone(New Rectangle(0, 0, Bmp.Width, Bmp.Height), PixelFormat.Format32bppArgb)
            FinishShape(Seen, False, True)
        End If

        Using Glowed As Bitmap = Glow(Seen)
            Using g As Graphics = Graphics.FromImage(Bmp)
                Dim Strength As New ColorMatrix()
                Strength.Matrix33 = SelfGlowStrength
                Using ia As New ImageAttributes()
                    ia.SetColorMatrix(Strength)
                    g.DrawImage(Glowed, New Rectangle(0, 0, Bmp.Width, Bmp.Height), OffX, 0, Bmp.Width, Bmp.Height, GraphicsUnit.Pixel, ia)
                End Using
            End Using
        End Using
        If Seen IsNot Bmp Then Seen.Dispose()

        Return Bmp

    End Function

    ''' <summary>A window background at the current UI scale (always rendered, see Img).</summary>
    Public Shared Function Window(Name As String) As Bitmap
        Return Render(Name, Scale, True, True)
    End Function

    ''' <summary>The pictures that are kept ready once rendered (the small ones).</summary>
    Public Shared Function CacheableNames() As List(Of String)
        Dim Res As New List(Of String)
        For Each N As String In BaseSizes.Keys
            If IsCacheable(N) Then Res.Add(N)
        Next
        Return Res
    End Function

    ''' <summary>Brings a 100%-size picture (e.g. from a form's own resources) to the current UI scale.</summary>
    Public Shared Function Enlarge(Source As Image) As Image
        If Source Is Nothing OrElse Math.Abs(Scale - 1.0F) < 0.001F Then Return Source
        Dim W As Integer = Math.Max(1, CInt(Math.Round(Source.Width * Scale)))
        Dim H As Integer = Math.Max(1, CInt(Math.Round(Source.Height * Scale)))
        Dim Bmp As New Bitmap(W, H, PixelFormat.Format32bppArgb)
        Using g As Graphics = Graphics.FromImage(Bmp)
            g.InterpolationMode = InterpolationMode.HighQualityBicubic
            g.PixelOffsetMode = PixelOffsetMode.Half
            Using ia As New ImageAttributes()
                ia.SetWrapMode(WrapMode.TileFlipXY)
                g.DrawImage(Source, New Rectangle(0, 0, W, H), 0, 0, Source.Width, Source.Height, GraphicsUnit.Pixel, ia)
            End Using
        End Using
        Return Bmp
    End Function

    ''' <summary>
    ''' One row of a sprite sheet as it looks on a window when the glow filter has run over both together:
    ''' the row is put on the window picture at SpriteAt, the whole is filtered the way the window is, and
    ''' the part inside Area is handed back (both rectangles in device pixels of the window).
    ''' This is for a caption that is a control of its own on a window picture and fills its control: filtered
    ''' by itself, its glow would stop dead at the control's edge and look like a plate behind the letters.
    ''' Instead the control is made a few pixels larger than the caption and shows this picture - outside the
    ''' reach of the caption's light it is identical to the window behind it.
    ''' </summary>
    Public Shared Function SpriteOnWindow(WindowName As String, SpriteName As String, Row As Integer, RowCount As Integer,
                                          SpriteAt As Rectangle, Area As Rectangle) As Bitmap

        Dim Res As New Bitmap(Math.Max(1, Area.Width), Math.Max(1, Area.Height), PixelFormat.Format32bppArgb)

        Using Win As Bitmap = Window(WindowName)

            Using Sheet As Bitmap = Render(SpriteName, Scale, True, True)
                Using g As Graphics = Graphics.FromImage(Win)
                    Dim RowH As Single = CSng(Sheet.Height) / RowCount
                    g.InterpolationMode = InterpolationMode.HighQualityBicubic
                    g.PixelOffsetMode = PixelOffsetMode.Half
                    g.DrawImage(Sheet, SpriteAt, 0.0F, RowH * Math.Max(0, Math.Min(RowCount - 1, Row)), CSng(Sheet.Width), RowH, GraphicsUnit.Pixel)
                End Using
            End Using

            Using Glowed As Bitmap = Glow(Win)
                Using g As Graphics = Graphics.FromImage(Res)
                    g.Clear(Color.Black)
                    g.InterpolationMode = InterpolationMode.NearestNeighbor
                    g.PixelOffsetMode = PixelOffsetMode.Half
                    g.DrawImage(Glowed, New Rectangle(0, 0, Area.Width, Area.Height), Area.X, Area.Y, Area.Width, Area.Height, GraphicsUnit.Pixel)
                End Using
            End Using

        End Using

        Return Res

    End Function

    Private Shared ReadOnly SpriteCache As New Dictionary(Of String, Bitmap)(StringComparer.Ordinal)

    ''' <summary>
    ''' Draws one row of a picture that stacks several equally high rows (a "sprite sheet",
    ''' e.g. the three KDF type captions) so that it fills Dest.
    ''' </summary>
    Public Shared Sub DrawSpriteRow(g As Graphics, Name As String, Row As Integer, RowCount As Integer, Dest As Rectangle)

        Dim Sheet As Bitmap = Nothing

        SyncLock SpriteCache
            If Not SpriteCache.TryGetValue(Name, Sheet) Then
                Sheet = Img(Name)
                SpriteCache(Name) = Sheet
            End If
        End SyncLock

        Dim RowH As Single = CSng(Sheet.Height) / RowCount

        g.InterpolationMode = InterpolationMode.HighQualityBicubic
        g.PixelOffsetMode = PixelOffsetMode.Half
        g.DrawImage(Sheet, Dest, 0.0F, RowH * Row, CSng(Sheet.Width), RowH, GraphicsUnit.Pixel)

    End Sub

    Public Shared Function Render(Name As String, AtScale As Single, UsePainter As Boolean, UseLayer As Boolean,
                                  Optional UseText As Boolean = True) As Bitmap

        Dim Der As DerivedPicture = Nothing
        If Derived.TryGetValue(Name, Der) Then
            Dim Part As Bitmap = RenderDerived(Der, Name, AtScale)
            ' a derived picture may have a painter as well: it draws on top of the copied part
            Dim Over As Action(Of ArtCanvas) = Nothing
            If UsePainter AndAlso Painters.TryGetValue(Name, Over) Then
                Dim KO As Integer = If(Math.Abs(AtScale - 1.0F) <= 0.001F, 4, If(AtScale >= 2.5F, 1, 2))
                Using Big As New Bitmap(Part.Width * KO, Part.Height * KO, PixelFormat.Format32bppPArgb)
                    Using g As Graphics = Graphics.FromImage(Big)
                        g.Clear(Color.FromArgb(0, 0, 0, 0))
                        g.SmoothingMode = SmoothingMode.AntiAlias
                        g.PixelOffsetMode = PixelOffsetMode.Half
                        Over(New ArtCanvas(g, AtScale, KO, BaseSizes(Name)))
                    End Using
                    Using Small As Bitmap = BoxDown(Big, KO)
                        Using g As Graphics = Graphics.FromImage(Part)
                            g.CompositingMode = CompositingMode.SourceOver
                            g.InterpolationMode = InterpolationMode.NearestNeighbor
                            g.PixelOffsetMode = PixelOffsetMode.Half
                            g.DrawImage(Small, New Rectangle(0, 0, Part.Width, Part.Height), 0, 0, Small.Width, Small.Height, GraphicsUnit.Pixel)
                        End Using
                    End Using
                End Using
            End If
            Return Part
        End If

        Dim IsLimeKeyed As Boolean = LimeKeyed.Contains(Name)
        Dim IsWindowShape As Boolean = IsLimeKeyed OrElse WindowShapes.Contains(Name)

        ' what is left of the artwork at 100%. Where that is only a small part of the picture, the art tool
        ' cuts the layer picture down to it and says where it goes: DrawPieces then sets it, see below.
        Dim Layer As Bitmap = Nothing
        If UseLayer AndAlso Not LayerIsPlaced(Name, Name) Then Layer = LayerProvider(Name)
        If Layer IsNot Nothing AndAlso IsLimeKeyed Then FinishShape(Layer, False, True)

        ' lettering pre-rendered at 200% (see UIArtText.vb). The art tool cuts this picture down to the part
        ' that holds something and says where it goes; it is then set by DrawPieces below, not stretched here.
        Dim Layer2x As Bitmap = Nothing
        If UseText AndAlso Not LayerIsPlaced(Name, Name + "@2x") Then Layer2x = LayerProvider(Name + "@2x")

        Dim BaseSize As Size
        If Not BaseSizes.TryGetValue(Name, BaseSize) Then
            If Layer Is Nothing Then Throw New ArgumentException("Unknown UI image: " + Name)
            BaseSize = Layer.Size
        End If

        Dim OutW As Integer = Math.Max(1, CInt(Math.Round(BaseSize.Width * AtScale)))
        Dim OutH As Integer = Math.Max(1, CInt(Math.Round(BaseSize.Height * AtScale)))
        Dim Bmp As Bitmap = Nothing

        Dim Painter As Action(Of ArtCanvas) = Nothing
        If UsePainter Then Painters.TryGetValue(Name, Painter)
        Dim DrawText As Boolean = UseText AndAlso HasText(Name)

        ' Painter and outline text work on an enlarged surface that is then averaged down
        ' (supersampling): GDI+ anti-aliasing alone is too coarse for the soft edges of the artwork.
        Dim K As Integer = 2
        If Math.Abs(AtScale - 1.0F) <= 0.001F Then K = 4
        If AtScale >= 2.5F Then K = 1

        If Painter IsNot Nothing OrElse DrawText Then

            Using Big As New Bitmap(OutW * K, OutH * K, PixelFormat.Format32bppPArgb)
                Using g As Graphics = Graphics.FromImage(Big)
                    g.Clear(Color.FromArgb(0, 0, 0, 0))
                    g.SmoothingMode = SmoothingMode.AntiAlias
                    g.PixelOffsetMode = PixelOffsetMode.Half
                    Dim Cv As New ArtCanvas(g, AtScale, K, BaseSize)
                    If Painter IsNot Nothing Then Painter(Cv)
                    If DrawText Then DrawTextRuns(Cv, Name)
                End Using
                Bmp = BoxDown(Big, K)
            End Using

        Else
            Bmp = New Bitmap(OutW, OutH, PixelFormat.Format32bppArgb)
        End If

        Using g As Graphics = Graphics.FromImage(Bmp)

            g.SmoothingMode = SmoothingMode.None
            g.CompositingMode = CompositingMode.SourceOver
            g.PixelOffsetMode = PixelOffsetMode.Half

            For Each Lay As Bitmap In {Layer, Layer2x}
                If Lay Is Nothing Then Continue For
                If OutW = Lay.Width AndAlso OutH = Lay.Height Then
                    g.InterpolationMode = InterpolationMode.NearestNeighbor
                    g.DrawImage(Lay, New Rectangle(0, 0, OutW, OutH), 0, 0, Lay.Width, Lay.Height, GraphicsUnit.Pixel)
                Else
                    g.InterpolationMode = InterpolationMode.HighQualityBicubic
                    Using ia As New ImageAttributes()
                        ia.SetWrapMode(WrapMode.TileFlipXY)
                        g.DrawImage(Lay, New Rectangle(0, 0, OutW, OutH), 0, 0, Lay.Width, Lay.Height, GraphicsUnit.Pixel, ia)
                    End Using
                End If
            Next

        End Using

        If Layer IsNot Nothing Then Layer.Dispose()
        If Layer2x IsNot Nothing Then Layer2x.Dispose()

        If UseText OrElse UseLayer Then DrawPieces(Bmp, Name, AtScale, UseLayer, UseText)
        If DrawText Then DrawLateText(Bmp, Name, AtScale, K, BaseSize)

        Dim After As Action(Of Bitmap, Single) = Nothing
        If UseText AndAlso AfterPainters.TryGetValue(Name, After) Then After(Bmp, AtScale)

        If IsWindowShape Then FinishShape(Bmp, IsLimeKeyed, False)

        Return Bmp

    End Function

    ' Pictures that are a part of another picture, darkened: the message of a message window is set on
    ' a dimmed copy of what the window shows at that place (X, Y in design pixels; the size is the
    ' picture's own). Tone: out = (in - Black) * Gain, the values the original pictures were made with.
    ' The "BORDER" line of the key derivation window is the piece of that window it lies on, unchanged,
    ' with the line painted over it (a derived picture that also has a painter).
    Private NotInheritable Class DerivedPicture
        Public ReadOnly Source As String
        Public ReadOnly X As Integer
        Public ReadOnly Y As Integer
        Public ReadOnly Black As Single
        Public ReadOnly Gain As Single
        Public Sub New(Source As String, X As Integer, Y As Integer, Black As Single, Gain As Single)
            Me.Source = Source
            Me.X = X
            Me.Y = Y
            Me.Black = Black
            Me.Gain = Gain
        End Sub
    End Class

    Private Shared ReadOnly Derived As New Dictionary(Of String, DerivedPicture)(StringComparer.Ordinal) From {
        {"Message_OK_TXTB_PNG", New DerivedPicture("Message_OK_PNG", 11, 90, 21.6F, 0.729F)},
        {"Message_VRF_TXTB_PNG", New DerivedPicture("Message_VRF_PNG", 11, 90, 0.0F, 0.2918F)},
        {"Message_CRI_TXTB_PNG", New DerivedPicture("Message_CRI_PNG", 11, 90, 0.0F, 0.268F)},
        {"PWD_KDF_LINE", New DerivedPicture("PWD_KDF", 5, 93, 0.0F, 1.0F)}}

    Private Shared Function RenderDerived(D As DerivedPicture, Name As String, AtScale As Single) As Bitmap

        Dim Sz As Size = BaseSizes(Name)
        Dim OutW As Integer = Math.Max(1, CInt(Math.Round(Sz.Width * AtScale)))
        Dim OutH As Integer = Math.Max(1, CInt(Math.Round(Sz.Height * AtScale)))
        Dim Res As New Bitmap(OutW, OutH, PixelFormat.Format32bppArgb)

        Using Src As Bitmap = Render(D.Source, AtScale, True, True)
            Dim X As Integer = Math.Max(0, Math.Min(Src.Width - OutW, CInt(Math.Round(D.X * AtScale))))
            Dim Y As Integer = Math.Max(0, Math.Min(Src.Height - OutH, CInt(Math.Round(D.Y * AtScale))))
            Using g As Graphics = Graphics.FromImage(Res)
                g.CompositingMode = CompositingMode.SourceCopy
                g.InterpolationMode = InterpolationMode.NearestNeighbor
                g.PixelOffsetMode = PixelOffsetMode.Half
                g.DrawImage(Src, New Rectangle(0, 0, OutW, OutH), X, Y, OutW, OutH, GraphicsUnit.Pixel)
            End Using
        End Using

        Dim Lut(255) As Byte
        For v As Integer = 0 To 255
            Lut(v) = CByte(Math.Max(0.0, Math.Min(255.0, Math.Round((v - D.Black) * D.Gain))))
        Next

        Dim BD As BitmapData = Res.LockBits(New Rectangle(0, 0, OutW, OutH), ImageLockMode.ReadWrite, PixelFormat.Format32bppArgb)
        Dim Pix(BD.Stride * OutH - 1) As Byte
        Marshal.Copy(BD.Scan0, Pix, 0, Pix.Length)
        For i As Integer = 0 To Pix.Length - 4 Step 4
            Pix(i) = Lut(Pix(i))
            Pix(i + 1) = Lut(Pix(i + 1))
            Pix(i + 2) = Lut(Pix(i + 2))
        Next
        Marshal.Copy(Pix, 0, BD.Scan0, Pix.Length)
        Res.UnlockBits(BD)

        Return Res

    End Function

    ' Pictures that give a window its outline. The forms cut their shape out with a transparency
    ' key colour, so these pictures must not have half-transparent edge pixels (they would show
    ' as a coloured fringe): every pixel is made either fully opaque or fully transparent.
    Private Shared ReadOnly WindowShapes As New HashSet(Of String)(StringComparer.Ordinal) From {
        "Title_LOGIN", "Title_NORMAL", "Title_Password", "Form_Main", "Form_Config",
        "File_expo_New", "mit_lic", "PWD_KDF"}

    ' Window pictures whose artwork paints the outside with the key colour itself (pure green).
    Private Shared ReadOnly LimeKeyed As New HashSet(Of String)(StringComparer.Ordinal) From {
        "Message_OK_PNG", "Message_VRF_PNG", "Message_CRI_PNG", "CSV_Waiting"}

    ''' <summary>
    ''' KeyToAlpha: turns pure-green pixels transparent (before a layer is enlarged).
    ''' Otherwise: makes alpha all-or-nothing and, with FillKey, paints the transparent part pure green.
    ''' </summary>
    Private Shared Sub FinishShape(Bmp As Bitmap, FillKey As Boolean, KeyToAlpha As Boolean)

        Dim BD As BitmapData = Bmp.LockBits(New Rectangle(0, 0, Bmp.Width, Bmp.Height), ImageLockMode.ReadWrite, PixelFormat.Format32bppArgb)
        Dim Pix(BD.Stride * Bmp.Height - 1) As Byte
        Marshal.Copy(BD.Scan0, Pix, 0, Pix.Length)

        For y As Integer = 0 To Bmp.Height - 1
            Dim i As Integer = y * BD.Stride
            For x As Integer = 0 To Bmp.Width - 1

                If KeyToAlpha Then
                    If Pix(i) = 0 AndAlso Pix(i + 1) = 255 AndAlso Pix(i + 2) = 0 Then
                        Pix(i + 1) = 0
                        Pix(i + 3) = 0
                    End If
                ElseIf Pix(i + 3) >= 128 Then
                    Pix(i + 3) = 255
                ElseIf FillKey Then
                    Pix(i) = 0
                    Pix(i + 1) = 255
                    Pix(i + 2) = 0
                    Pix(i + 3) = 255
                Else
                    Pix(i) = 0
                    Pix(i + 1) = 0
                    Pix(i + 2) = 0
                    Pix(i + 3) = 0
                End If

                i += 4
            Next
        Next

        Marshal.Copy(Pix, 0, BD.Scan0, Pix.Length)
        Bmp.UnlockBits(BD)

    End Sub

    ''' <summary>Tool use: True while arttool builds the layer pictures (painters then leave out what is not in the artwork).</summary>
    Public Shared BuildingLayers As Boolean = False

    ''' <summary>Tool use: when set, painters record here the areas they fully draw (see ArtCanvas.Claim).</summary>
    Public Shared ClaimSink As List(Of RectangleF) = Nothing

    ''' <summary>Averages K x K blocks of a premultiplied-alpha bitmap into a normal ARGB bitmap.</summary>
    Private Shared Function BoxDown(Big As Bitmap, K As Integer) As Bitmap

        Dim W As Integer = Big.Width \ K
        Dim H As Integer = Big.Height \ K
        Dim Result As New Bitmap(W, H, PixelFormat.Format32bppArgb)

        Dim SrcBD As BitmapData = Big.LockBits(New Rectangle(0, 0, Big.Width, Big.Height), ImageLockMode.ReadOnly, PixelFormat.Format32bppPArgb)
        Dim SrcStride As Integer = SrcBD.Stride
        Dim Src(SrcStride * Big.Height - 1) As Byte
        Marshal.Copy(SrcBD.Scan0, Src, 0, Src.Length)
        Big.UnlockBits(SrcBD)

        Dim Dst(W * H * 4 - 1) As Byte
        Dim N As Integer = K * K
        Dim Half As Integer = N \ 2

        For y As Integer = 0 To H - 1
            For x As Integer = 0 To W - 1
                Dim sb As Integer = 0, sg As Integer = 0, sr As Integer = 0, sa As Integer = 0
                For ky As Integer = 0 To K - 1
                    Dim si As Integer = (y * K + ky) * SrcStride + x * K * 4
                    For kx As Integer = 0 To K - 1
                        sb += Src(si)
                        sg += Src(si + 1)
                        sr += Src(si + 2)
                        sa += Src(si + 3)
                        si += 4
                    Next
                Next
                If sa > 0 Then
                    Dim di As Integer = (y * W + x) * 4
                    ' un-premultiply: colour = sum(colour*alpha) / sum(alpha)
                    Dst(di) = CByte(Math.Min(255, (sb * 255 + sa \ 2) \ sa))
                    Dst(di + 1) = CByte(Math.Min(255, (sg * 255 + sa \ 2) \ sa))
                    Dst(di + 2) = CByte(Math.Min(255, (sr * 255 + sa \ 2) \ sa))
                    Dst(di + 3) = CByte((sa + Half) \ N)
                End If
            Next
        Next

        Dim DstBD As BitmapData = Result.LockBits(New Rectangle(0, 0, W, H), ImageLockMode.WriteOnly, PixelFormat.Format32bppArgb)
        For y As Integer = 0 To H - 1
            Marshal.Copy(Dst, y * W * 4, IntPtr.Add(DstBD.Scan0, y * DstBD.Stride), W * 4)
        Next
        Result.UnlockBits(DstBD)

        Return Result

    End Function

    Private Shared Function EmbeddedLayer(Name As String) As Bitmap

        Dim Asm As Reflection.Assembly = GetType(UIArt).Assembly

        Using St As IO.Stream = Asm.GetManifestResourceStream("UIArtLayer." + Name + ".png")
            If St Is Nothing Then Return Nothing
            Using Tmp As New Bitmap(St)
                ' Detach from the stream and normalise the pixel format / DPI tag.
                Dim Bmp As New Bitmap(Tmp.Width, Tmp.Height, PixelFormat.Format32bppArgb)
                Using g As Graphics = Graphics.FromImage(Bmp)
                    g.CompositingMode = CompositingMode.SourceCopy
                    g.InterpolationMode = InterpolationMode.NearestNeighbor
                    g.PixelOffsetMode = PixelOffsetMode.Half
                    g.DrawImage(Tmp, New Rectangle(0, 0, Tmp.Width, Tmp.Height), 0, 0, Tmp.Width, Tmp.Height, GraphicsUnit.Pixel)
                End Using
                Return Bmp
            End Using
        End Using

    End Function

End Class

''' <summary>
''' Drawing surface for painters. All coordinates are in 96-DPI design pixels (may be fractional);
''' the canvas converts them to device pixels. At 100% nothing is snapped, so the output follows
''' the original artwork (including its soft edges). Above 100% straight edges are snapped to
''' whole device pixels so they stay sharp.
''' </summary>
Public NotInheritable Class ArtCanvas

    Public ReadOnly G As Graphics
    Public ReadOnly Sc As Single        'design pixel -> device pixel
    Public ReadOnly K As Integer        'supersampling: surface pixels per device pixel
    Public ReadOnly Snap As Boolean
    Public ReadOnly BaseSize As Size

    Public Sub New(Gr As Graphics, AtScale As Single, SuperSample As Integer, Size1x As Size)
        G = Gr
        Sc = AtScale
        K = SuperSample
        Snap = Math.Abs(AtScale - 1.0F) > 0.001F
        BaseSize = Size1x
    End Sub

    ''' <summary>Design coordinate -> surface coordinate (on a device pixel boundary when snapping).</summary>
    Public Function P(v As Single) As Single
        If Snap Then Return CSng(Math.Floor(v * Sc + 0.5F)) * K
        Return v * Sc * K
    End Function

    ''' <summary>Design coordinate -> surface coordinate, never snapped.</summary>
    Public Function PRaw(v As Single) As Single
        Return v * Sc * K
    End Function

    ''' <summary>Design length -> surface length (whole device pixels, at least one, when snapping).</summary>
    Public Function L(v As Single) As Single
        If Not Snap Then Return v * Sc * K
        If v <= 0.0F Then Return 0.0F
        Return CSng(Math.Max(1.0, Math.Floor(v * Sc + 0.5F))) * K
    End Function

    ''' <summary>Design length -> surface length, never snapped (radii and the like).</summary>
    Public Function LRaw(v As Single) As Single
        Return v * Sc * K
    End Function

    Public Shared Function RGB(Hex As Integer, Optional Alpha As Integer = 255) As Color
        Return Color.FromArgb(Alpha, (Hex >> 16) And 255, (Hex >> 8) And 255, Hex And 255)
    End Function

    ''' <summary>
    ''' Declares that the painter draws everything inside this rectangle (design pixels), i.e. there is
    ''' no text in it. arttool then takes nothing from the original artwork there, so small rendering
    ''' differences (corner pixels, anti-aliasing) do not end up in the layer picture.
    ''' </summary>
    Public Sub Claim(x0 As Single, y0 As Single, x1 As Single, y1 As Single)
        If UIArt.ClaimSink IsNot Nothing Then UIArt.ClaimSink.Add(RectangleF.FromLTRB(x0, y0, x1, y1))
    End Sub

    ''' <summary>Filled rectangle given by its edges. Both edges are snapped independently (areas, panels).</summary>
    Public Sub Box(c As Color, x0 As Single, y0 As Single, x1 As Single, y1 As Single)
        Dim dx0 As Single = P(x0), dy0 As Single = P(y0), dx1 As Single = P(x1), dy1 As Single = P(y1)
        If dx1 <= dx0 OrElse dy1 <= dy0 Then Exit Sub
        Using b As New SolidBrush(c)
            G.FillRectangle(b, dx0, dy0, dx1 - dx0, dy1 - dy0)
        End Using
    End Sub

    ''' <summary>Filled rectangle whose position and thickness are snapped (strokes, rules, ticks).</summary>
    Public Sub Bar(c As Color, x0 As Single, y0 As Single, x1 As Single, y1 As Single)
        Dim dx0 As Single = P(x0), dy0 As Single = P(y0)
        Dim dw As Single = L(x1 - x0), dh As Single = L(y1 - y0)
        If dw <= 0 OrElse dh <= 0 Then Exit Sub
        Using b As New SolidBrush(c)
            G.FillRectangle(b, dx0, dy0, dw, dh)
        End Using
    End Sub

    ''' <summary>Horizontal rule: spans x0..x1 (edge snapped), thickness t starting at y.</summary>
    Public Sub HLine(c As Color, x0 As Single, x1 As Single, y As Single, t As Single)
        Dim dx0 As Single = P(x0), dx1 As Single = P(x1), dy0 As Single = P(y), dh As Single = L(t)
        If dx1 <= dx0 OrElse dh <= 0 Then Exit Sub
        Using b As New SolidBrush(c)
            G.FillRectangle(b, dx0, dy0, dx1 - dx0, dh)
        End Using
    End Sub

    ''' <summary>Vertical rule: spans y0..y1 (edge snapped), thickness t starting at x.</summary>
    Public Sub VLine(c As Color, x As Single, y0 As Single, y1 As Single, t As Single)
        Dim dy0 As Single = P(y0), dy1 As Single = P(y1), dx0 As Single = P(x), dw As Single = L(t)
        If dy1 <= dy0 OrElse dw <= 0 Then Exit Sub
        Using b As New SolidBrush(c)
            G.FillRectangle(b, dx0, dy0, dw, dy1 - dy0)
        End Using
    End Sub

    Private Function ToPoints(pts() As Single, DoSnap As Boolean) As PointF()
        Dim n As Integer = pts.Length \ 2
        Dim r(n - 1) As PointF
        For i As Integer = 0 To n - 1
            If DoSnap Then
                r(i) = New PointF(P(pts(i * 2)), P(pts(i * 2 + 1)))
            Else
                r(i) = New PointF(PRaw(pts(i * 2)), PRaw(pts(i * 2 + 1)))
            End If
        Next
        Return r
    End Function

    ''' <summary>
    ''' Draws a layer picture (a hand-made 200% picture, see UIArt.HandMadePictures) so that it fills the
    ''' design rectangle x0..x1, y0..y1.
    ''' </summary>
    Public Sub Picture(Name As String, x0 As Single, y0 As Single, x1 As Single, y1 As Single)
        Using Pic As Bitmap = UIArt.LayerProvider(Name)
            If Pic Is Nothing Then Exit Sub
            Dim dx0 As Single = PRaw(x0), dy0 As Single = PRaw(y0), dx1 As Single = PRaw(x1), dy1 As Single = PRaw(y1)
            Dim Fx As Single = (dx1 - dx0) / Pic.Width, Fy As Single = (dy1 - dy0) / Pic.Height
            Dim Whole As Boolean = Math.Abs(Fx - Math.Round(Fx)) < 0.001F AndAlso Math.Abs(Fy - Math.Round(Fy)) < 0.001F AndAlso Fx >= 1
            Dim Saved As InterpolationMode = G.InterpolationMode
            G.InterpolationMode = If(Whole, InterpolationMode.NearestNeighbor, InterpolationMode.HighQualityBicubic)
            Using ia As New ImageAttributes()
                ia.SetWrapMode(WrapMode.TileFlipXY)
                G.DrawImage(Pic, New PointF() {New PointF(dx0, dy0), New PointF(dx1, dy0), New PointF(dx0, dy1)},
                            New RectangleF(0, 0, Pic.Width, Pic.Height), GraphicsUnit.Pixel, ia)
            End Using
            G.InterpolationMode = Saved
        End Using
    End Sub

    ''' <summary>Filled polygon (x0,y0,x1,y1...). Vertices are snapped above 100%.</summary>
    Public Sub Poly(c As Color, ParamArray pts() As Single)
        Using b As New SolidBrush(c)
            G.FillPolygon(b, ToPoints(pts, True))
        End Using
    End Sub

    ''' <summary>Filled polygon with un-snapped vertices (small glyph-like shapes).</summary>
    Public Sub PolyRaw(c As Color, ParamArray pts() As Single)
        Using b As New SolidBrush(c)
            G.FillPolygon(b, ToPoints(pts, False))
        End Using
    End Sub

    ''' <summary>
    ''' Poly-line stroke. Points are the centre line in design pixels; t is the design thickness.
    ''' Above 100% the centre line is placed so that the stroke covers whole device pixels.
    ''' </summary>
    Public Sub Stroke(c As Color, t As Single, Closed As Boolean, ParamArray pts() As Single)

        Dim n As Integer = pts.Length \ 2
        Dim r(n - 1) As PointF
        Dim dw As Single = L(t)

        For i As Integer = 0 To n - 1
            If Snap Then
                ' The design centre line sits t/2 inside the stroke; keep the stroke's top/left edge snapped.
                Dim ex As Single = P(pts(i * 2) - t / 2)
                Dim ey As Single = P(pts(i * 2 + 1) - t / 2)
                r(i) = New PointF(ex + dw / 2, ey + dw / 2)
            Else
                r(i) = New PointF(PRaw(pts(i * 2)), PRaw(pts(i * 2 + 1)))
            End If
        Next

        Using pn As New Pen(c, dw)
            pn.LineJoin = LineJoin.Miter
            pn.MiterLimit = 4
            pn.StartCap = LineCap.Flat
            pn.EndCap = LineCap.Flat
            If Closed Then
                G.DrawPolygon(pn, r)
            Else
                G.DrawLines(pn, r)
            End If
        End Using

    End Sub

    '--------------------------------------------------------------------------------------------
    ' Shapes: closed polygons with individually rounded corners (window outlines, tabs, panels).
    '--------------------------------------------------------------------------------------------

    ''' <summary>Builds a closed path through Pts (surface coordinates); corner i is rounded with radius Radii(i).</summary>
    Private Shared Function ShapePath(Pts() As PointF, Radii() As Single) As GraphicsPath

        Dim n As Integer = Pts.Length
        Dim gp As New GraphicsPath()
        Dim HavePrev As Boolean = False
        Dim PrevPt As PointF

        For i As Integer = 0 To n - 1

            Dim V As PointF = Pts(i)
            Dim A As PointF = Pts((i + n - 1) Mod n)
            Dim B As PointF = Pts((i + 1) Mod n)

            Dim l1 As Double = Math.Sqrt((V.X - A.X) ^ 2 + (V.Y - A.Y) ^ 2)
            Dim l2 As Double = Math.Sqrt((B.X - V.X) ^ 2 + (B.Y - V.Y) ^ 2)
            Dim R As Double = Radii(i)

            Dim T1 As PointF = V, T2 As PointF = V
            Dim IsRound As Boolean = False
            Dim C1 As PointF, C2 As PointF

            If R > 0.01 AndAlso l1 > 0.01 AndAlso l2 > 0.01 Then
                Dim u1x As Double = (V.X - A.X) / l1, u1y As Double = (V.Y - A.Y) / l1
                Dim u2x As Double = (B.X - V.X) / l2, u2y As Double = (B.Y - V.Y) / l2
                Dim CosT As Double = Math.Max(-1.0, Math.Min(1.0, u1x * u2x + u1y * u2y))
                Dim Turn As Double = Math.Acos(CosT)           'direction change at this corner
                If Turn > 0.01 AndAlso Turn < Math.PI - 0.01 Then
                    Dim d As Double = R * Math.Tan(Turn / 2)   'distance from the corner to the tangent points
                    d = Math.Min(d, Math.Min(l1, l2) / 2)
                    Dim RR As Double = d / Math.Tan(Turn / 2)
                    Dim k As Double = (4.0 / 3.0) * Math.Tan(Turn / 4) * RR
                    T1 = New PointF(CSng(V.X - u1x * d), CSng(V.Y - u1y * d))
                    T2 = New PointF(CSng(V.X + u2x * d), CSng(V.Y + u2y * d))
                    C1 = New PointF(CSng(T1.X + u1x * k), CSng(T1.Y + u1y * k))
                    C2 = New PointF(CSng(T2.X - u2x * k), CSng(T2.Y - u2y * k))
                    IsRound = True
                End If
            End If

            If HavePrev Then gp.AddLine(PrevPt, T1)
            If IsRound Then gp.AddBezier(T1, C1, C2, T2)
            PrevPt = T2
            HavePrev = True

        Next

        gp.CloseFigure()
        Return gp

    End Function

    ''' <summary>Moves every edge of the polygon inwards by Dist and returns the new corner points.</summary>
    Private Shared Function InsetPolygon(Pts() As PointF, Dist As Single, ByRef Convex() As Boolean) As PointF()

        Dim n As Integer = Pts.Length
        Dim Area2 As Double = 0
        For i As Integer = 0 To n - 1
            Dim q As PointF = Pts((i + 1) Mod n)
            Area2 += CDbl(Pts(i).X) * q.Y - CDbl(q.X) * Pts(i).Y
        Next
        Dim Sg As Double = If(Area2 >= 0, 1.0, -1.0)

        Dim Res(n - 1) As PointF
        ReDim Convex(n - 1)

        For i As Integer = 0 To n - 1

            Dim V As PointF = Pts(i)
            Dim A As PointF = Pts((i + n - 1) Mod n)
            Dim B As PointF = Pts((i + 1) Mod n)

            Dim d1x As Double = V.X - A.X, d1y As Double = V.Y - A.Y
            Dim d2x As Double = B.X - V.X, d2y As Double = B.Y - V.Y
            Dim l1 As Double = Math.Sqrt(d1x * d1x + d1y * d1y)
            Dim l2 As Double = Math.Sqrt(d2x * d2x + d2y * d2y)
            If l1 < 0.0001 OrElse l2 < 0.0001 Then
                Res(i) = V
                Convex(i) = True
                Continue For
            End If
            d1x /= l1 : d1y /= l1 : d2x /= l2 : d2y /= l2

            'inward normals of the two edges
            Dim n1x As Double = -d1y * Sg, n1y As Double = d1x * Sg
            Dim n2x As Double = -d2y * Sg, n2y As Double = d2x * Sg

            Dim Cross As Double = d1x * d2y - d1y * d2x
            Convex(i) = (Cross * Sg) >= 0

            'intersection of the two shifted edges
            Dim p1x As Double = V.X + n1x * Dist, p1y As Double = V.Y + n1y * Dist
            Dim p2x As Double = V.X + n2x * Dist, p2y As Double = V.Y + n2y * Dist

            If Math.Abs(Cross) < 0.000001 Then
                Res(i) = New PointF(CSng(p1x), CSng(p1y))
            Else
                Dim t As Double = ((p2x - p1x) * d2y - (p2y - p1y) * d2x) / Cross
                Res(i) = New PointF(CSng(p1x + d1x * t), CSng(p1y + d1y * t))
            End If

        Next

        Return Res

    End Function

    ''' <summary>
    ''' Closed shape with rounded corners: Corners = x, y, radius, x, y, radius ... (design pixels).
    ''' Outline: an outline of thickness t is drawn inside the shape; Fill: the inside colour
    ''' (use Color.Empty for "outline only"). Straight edges are snapped above 100%.
    ''' </summary>
    Public Sub Shape(Fill As Color, Outline As Color, t As Single, ParamArray Corners() As Single)

        Dim n As Integer = Corners.Length \ 3
        Dim Pts(n - 1) As PointF
        Dim Radii(n - 1) As Single

        For i As Integer = 0 To n - 1
            Pts(i) = New PointF(P(Corners(i * 3)), P(Corners(i * 3 + 1)))
            Radii(i) = LRaw(Corners(i * 3 + 2))
        Next

        Dim dt As Single = If(t > 0, L(t), 0.0F)

        Using Outer As GraphicsPath = ShapePath(Pts, Radii)

            If dt <= 0 OrElse Outline.IsEmpty Then
                If Not Fill.IsEmpty Then
                    Using b As New SolidBrush(Fill)
                        G.FillPath(b, Outer)
                    End Using
                End If
                Exit Sub
            End If

            Dim Convex() As Boolean = Nothing
            Dim InPts() As PointF = InsetPolygon(Pts, dt, Convex)
            Dim InRadii(n - 1) As Single
            For i As Integer = 0 To n - 1
                If Radii(i) <= 0.01F Then
                    InRadii(i) = 0
                ElseIf Convex(i) Then
                    InRadii(i) = Math.Max(0.0F, Radii(i) - dt)
                Else
                    InRadii(i) = Radii(i) + dt
                End If
            Next

            Using Inner As GraphicsPath = ShapePath(InPts, InRadii)

                If Not Fill.IsEmpty Then
                    Using b As New SolidBrush(Fill)
                        G.FillPath(b, Outer)
                    End Using
                End If

                Using Ring As New GraphicsPath(FillMode.Alternate)
                    Ring.AddPath(Outer, False)
                    Ring.AddPath(Inner, False)
                    Using b As New SolidBrush(Outline)
                        G.FillPath(b, Ring)
                    End Using
                End Using

            End Using

        End Using

    End Sub

    Private Shared Function RoundPath(x0 As Single, y0 As Single, x1 As Single, y1 As Single, r As Single) As GraphicsPath
        Dim gp As New GraphicsPath()
        Dim d As Single = Math.Min(r * 2, Math.Min(x1 - x0, y1 - y0))
        If d <= 0.01F Then
            gp.AddRectangle(New RectangleF(x0, y0, x1 - x0, y1 - y0))
        Else
            gp.AddArc(x0, y0, d, d, 180, 90)
            gp.AddArc(x1 - d, y0, d, d, 270, 90)
            gp.AddArc(x1 - d, y1 - d, d, d, 0, 90)
            gp.AddArc(x0, y1 - d, d, d, 90, 90)
            gp.CloseFigure()
        End If
        Return gp
    End Function

    ''' <summary>Filled rounded rectangle (outer edges x0..x1, y0..y1, corner radius r).</summary>
    Public Sub RoundBox(c As Color, x0 As Single, y0 As Single, x1 As Single, y1 As Single, r As Single)
        RoundBoxRaw(c, P(x0), P(y0), P(x1), P(y1), LRaw(r))
    End Sub

    ''' <summary>The same in surface coordinates (for painters that measure from the picture's real edges).</summary>
    Public Sub RoundBoxRaw(c As Color, x0 As Single, y0 As Single, x1 As Single, y1 As Single, r As Single)
        If x1 <= x0 OrElse y1 <= y0 Then Exit Sub
        Using gp As GraphicsPath = RoundPath(x0, y0, x1, y1, r)
            Using b As New SolidBrush(c)
                G.FillPath(b, gp)
            End Using
        End Using
    End Sub

    ''' <summary>Rounded rectangle outline of thickness t inside the outer edges x0..x1, y0..y1, in surface coordinates.</summary>
    Public Sub RoundFrameRaw(c As Color, x0 As Single, y0 As Single, x1 As Single, y1 As Single, r As Single, t As Single)
        If x1 <= x0 OrElse y1 <= y0 Then Exit Sub
        Using gp As GraphicsPath = RoundPath(x0, y0, x1, y1, r)
            If x1 - x0 > 2 * t AndAlso y1 - y0 > 2 * t Then
                Using gi As GraphicsPath = RoundPath(x0 + t, y0 + t, x1 - t, y1 - t, Math.Max(0.0F, r - t))
                    gp.AddPath(gi, False)
                End Using
                gp.FillMode = FillMode.Alternate
            End If
            Using b As New SolidBrush(c)
                G.FillPath(b, gp)
            End Using
        End Using
    End Sub

    ''' <summary>Rounded rectangle outline of thickness t, lying inside the outer edges x0..x1, y0..y1.</summary>
    Public Sub RoundFrame(c As Color, x0 As Single, y0 As Single, x1 As Single, y1 As Single, r As Single, t As Single)
        Dim dx0 As Single = P(x0), dy0 As Single = P(y0), dx1 As Single = P(x1), dy1 As Single = P(y1)
        Dim dt As Single = L(t)
        Using gp As GraphicsPath = RoundPath(dx0, dy0, dx1, dy1, LRaw(r))
            Using gi As GraphicsPath = RoundPath(dx0 + dt, dy0 + dt, dx1 - dt, dy1 - dt, Math.Max(0.0F, LRaw(r) - dt))
                gp.AddPath(gi, False)
                gp.FillMode = FillMode.Alternate
                Using b As New SolidBrush(c)
                    G.FillPath(b, gp)
                End Using
            End Using
        End Using
    End Sub

    ''' <summary>Rectangle filled with a horizontal multi-stop gradient. Stops: position(0..1), colour.</summary>
    Public Sub GradBoxH(x0 As Single, y0 As Single, x1 As Single, y1 As Single, Positions() As Single, Colors() As Color)
        Dim dx0 As Single = P(x0), dy0 As Single = P(y0), dx1 As Single = P(x1), dy1 As Single = P(y1)
        If dx1 <= dx0 OrElse dy1 <= dy0 Then Exit Sub
        Using lg As New LinearGradientBrush(New PointF(dx0, 0), New PointF(dx1, 0), Colors(0), Colors(Colors.Length - 1))
            Dim cb As New ColorBlend(Colors.Length)
            cb.Colors = Colors
            cb.Positions = Positions
            lg.InterpolationColors = cb
            lg.WrapMode = WrapMode.TileFlipX
            G.FillRectangle(lg, dx0, dy0, dx1 - dx0, dy1 - dy0)
        End Using
    End Sub

End Class
